# Leave empty in development (Vite proxies /api to the backend).
# For a production build served from another origin, set the full API URL, e.g. https://api.example.com/api
VITE_API_URL=
# Dev proxy target (only used by `npm run dev` / `npm run preview`)
VITE_PROXY_TARGET=http://localhost:4000

# Only if the API is on another origin: where menu photos (/uploads/...) are loaded from
# VITE_ASSET_URL=https://your-api
